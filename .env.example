PORT=3000

# --- Telegram: leitura automática dos canais-fonte (userbot MTProto) ---
# Crie um app em https://my.telegram.org para conseguir API_ID/API_HASH.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Gerada uma vez com `npm run telegram-login` — NUNCA versionar, dá acesso
# total à sua conta pessoal do Telegram, igual uma senha.
TELEGRAM_SESSION_STRING=

# --- Telegram: publicação automática no seu canal (bot oficial, baixo risco) ---
# Crie um bot via @BotFather e adicione-o como admin do seu canal.
TELEGRAM_BOT_TOKEN=
# Opcional: seu chat pessoal, para receber alertas (ex.: sessão do Mercado
# Livre expirada). Sem isso, alertas só aparecem no log do servidor.
TELEGRAM_OWNER_CHAT_ID=

# --- Mercado Livre: geração automática de link via navegador ---
# Caminho onde a sessão logada fica salva (gerada com `npm run ml-login`).
ML_STORAGE_STATE_PATH=data/ml-storage-state.json
